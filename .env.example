# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 应用配置
VITE_NAME=Universe Life
VITE_VERSION=1.0.0
VITE_ENV=development
REACT_APP_NAME=Universe Life
REACT_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=development

# API配置（网关服务地址 - 本地开发）
VITE_API_BASE_URL=http://localhost:8101
REACT_APP_API_TIMEOUT=30000
REACT_APP_API_RETRY_ATTEMPTS=3

# WebSocket配置
REACT_APP_SOCKET_URL=wss://ws.universe-life.com
REACT_APP_SOCKET_RECONNECT_ATTEMPTS=5
REACT_APP_SOCKET_RECONNECT_DELAY=3000

# 安全配置
REACT_APP_TOKEN_ENCRYPTION_KEY=your-256-bit-encryption-key-here
REACT_APP_PAYMENT_ENCRYPTION_KEY=your-payment-encryption-key-here
REACT_APP_SESSION_TIMEOUT=1800000
REACT_APP_MAX_LOGIN_ATTEMPTS=5

# 功能开关
REACT_APP_ENABLE_2FA=true
REACT_APP_ENABLE_AUDIT_LOG=true
REACT_APP_ENABLE_SECURITY_MONITORING=true
REACT_APP_ENFORCE_HTTPS=true

# 第三方服务
REACT_APP_STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
REACT_APP_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
REACT_APP_SENTRY_DSN=https://your-sentry-dsn

# 文件上传配置
REACT_APP_MAX_FILE_SIZE=10485760
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# 地图服务
REACT_APP_MAP_API_KEY=your-map-api-key
REACT_APP_MAP_PROVIDER=google

# 消息推送
REACT_APP_FIREBASE_CONFIG={
  "apiKey": "your-firebase-api-key",
  "authDomain": "your-project.firebaseapp.com",
  "projectId": "your-project-id",
  "messagingSenderId": "123456789",
  "appId": "your-app-id"
}

# =============================================
# OAuth2 PKCE 认证配置（本地开发环境）
# =============================================

# OAuth2 授权服务器基础URL（本地授权服务器）
VITE_OAUTH_BASE_URL=http://localhost:8099

# 客户端ID（前端可以安全存储）
VITE_CLIENT_ID=your-client-id

# 回调地址（必须与OAuth2服务器注册的地址完全一致）
VITE_REDIRECT_URI=http://localhost:3000/auth/callback

# 登出重定向URI（可选）
# VITE_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# 权限范围（可选，默认为 'openid profile email offline_access read write user_info'）
REACT_APP_SCOPES=openid profile email offline_access read write user_info

# 社交登录
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
REACT_APP_FACEBOOK_APP_ID=your-facebook-app-id
REACT_APP_WECHAT_APP_ID=your-wechat-app-id

# 支付配置
REACT_APP_PAYMENT_PROVIDERS=stripe,alipay,wechat_pay
REACT_APP_CURRENCY=CNY
REACT_APP_PAYMENT_TIMEOUT=900000

# 客服配置
REACT_APP_CUSTOMER_SERVICE_URL=https://support.universe-life.com
REACT_APP_CUSTOMER_SERVICE_EMAIL=support@universe-life.com
REACT_APP_CUSTOMER_SERVICE_PHONE=400-123-4567

# 隐私配置
REACT_APP_PRIVACY_POLICY_URL=https://universe-life.com/privacy
REACT_APP_TERMS_OF_SERVICE_URL=https://universe-life.com/terms
REACT_APP_COOKIE_POLICY_URL=https://universe-life.com/cookies

# 开发配置（仅开发环境）
REACT_APP_ENABLE_DEBUG_TOOLS=true
REACT_APP_ENABLE_CONSOLE_LOG=true
REACT_APP_MOCK_API=false
REACT_APP_API_MOCK_DELAY=1000

# 生产配置（仅生产环境）
REACT_APP_ENABLE_DEBUG_TOOLS=false
REACT_APP_ENABLE_CONSOLE_LOG=false
REACT_APP_MOCK_API=false

# CDN配置
REACT_APP_CDN_URL=https://cdn.universe-life.com
REACT_APP_STATIC_URL=https://static.universe-life.com

# 缓存配置
REACT_APP_CACHE_ENABLED=true
REACT_APP_CACHE_DURATION=300000
REACT_APP_CACHE_VERSION=v1.0.0

# 监控配置
REACT_APP_ERROR_TRACKING=true
REACT_APP_PERFORMANCE_MONITORING=true
REACT_APP_USER_BEHAVIOR_TRACKING=true

# 国际化配置
REACT_APP_DEFAULT_LANGUAGE=zh-CN
REACT_APP_SUPPORTED_LANGUAGES=zh-CN,en-US,ja-JP
REACT_APP_I18N_NAMESPACE=common

# 地理配置
REACT_APP_DEFAULT_COUNTRY=CN
REACT_APP_TIMEZONE=Asia/Shanghai
REACT_APP_CURRENCY_LOCALE=zh-CN

# 安全策略配置
REACT_APP_CSP_ENABLED=true
REACT_APP_HSTS_ENABLED=true
REACT_APP_CORS_ENABLED=true
REACT_APP_RATE_LIMITING=true

# 合规配置
REACT_APP_GDPR_COMPLIANCE=true
REACT_APP_DATA_RETENTION_DAYS=2555
REACT_APP_AUDIT_LOG_RETENTION_DAYS=365

# 性能配置
REACT_APP_LAZY_LOADING=true
REACT_APP_CODE_SPLITTING=true
REACT_APP_TREESHAKING=true
REACT_APP_MINIFICATION=true

# 预加载配置
REACT_APP_PRELOAD_CRITICAL_RESOURCES=true
REACT_APP_PRELOAD_NEXT_PAGES=true
REACT_APP_PRELOAD_IMAGES=true

# 优化配置
REACT_APP_IMAGE_OPTIMIZATION=true
REACT_APP_IMAGE_FORMATS=webp,avif
REACT_APP_IMAGE_QUALITY=80

# 服务工作者配置
REACT_APP_ENABLE_SERVICE_WORKER=true
REACT_APP_CACHE_STRATEGY=networkFirst
REACT_APP_OFFLINE_SUPPORT=true

# PWA配置
REACT_APP_PWA_ENABLED=true
REACT_APP_PWA_NAME=Universe Life
REACT_APP_PWA_SHORT_NAME=Universe
REACT_APP_PWA_THEME_COLOR=#1890ff

# 推送通知配置
REACT_APP_PUSH_NOTIFICATIONS=true
REACT_APP_VAPID_PUBLIC_KEY=your-vapid-public-key

# 分析配置
REACT_APP_HEATMAP_ANALYTICS=true
REACT_APP_SCROLL_DEPTH_TRACKING=true
REACT_APP_CLICK_TRACKING=true
REACT_APP_FORM_ANALYTICS=true

# 实验性功能
REACT_APP_EXPERIMENTAL_FEATURES=false
REACT_APP_BETA_FEATURES=false
REACT_APP_NEW_UI=false