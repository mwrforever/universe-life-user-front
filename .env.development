# 开发环境配置
NODE_ENV=development

# =============================================
# OAuth2 PKCE 认证配置
# =============================================

# OAuth2 授权服务器基础URL（本地开发环境）
VITE_OAUTH_BASE_URL=http://localhost:8099

# 客户端ID（前端可以安全存储）
VITE_CLIENT_ID=fCSYj5XOia6J4O9shfka

# 回调地址（必须与OAuth2服务器注册的地址完全一致）
VITE_REDIRECT_URI=http://localhost:3000/auth/callback

# 权限范围
VITE_SCOPES=openid profile email offline_access read write user_info

# 环境标识
VITE_ENV=development

# =============================================
# 应用配置
# =============================================
VITE_NAME=Universe Life
VITE_VERSION=1.0.0

# API配置（网关服务地址 - 本地开发环境）
VITE_API_BASE_URL=http://localhost:8101

# 登出重定向URI（可选）
VITE_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# 调试配置
VITE_ENABLE_DEBUG_TOOLS=true
VITE_ENABLE_CONSOLE_LOG=true